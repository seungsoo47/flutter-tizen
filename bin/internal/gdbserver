set -e

kill_gdbserver_if_running() {
  current_attr="$(cat /proc/self/attr/current)" || return 0
  case "$current_attr" in
    User::Pkg::*) ;;
    *) return 0 ;;
  esac
  ps -eZ | awk -v attr="$current_attr" \
    '$1 == attr && ($NF == "<defunct>" || $NF == "gdbserver_real") { print $2 }' |
    while read -r pid; do
      # The process may have already exited.
      kill "$pid" 2>/dev/null || true
    done
}

kill_gdbserver_if_running

SCRIPT_DIR="$(dirname "$0")"
"$SCRIPT_DIR/gdbserver_real" "$@"
